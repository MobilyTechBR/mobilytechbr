{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "buildCommand": "python3 scripts/build_phase2_ibuy_style.py || python scripts/build_phase2_ibuy_style.py",
  "outputDirectory": ".",
  "routes": [
    {
      "src": "/api/auth-session/?",
      "dest": "/api/account?action=session"
    },
    {
      "src": "/api/customer-orders/?",
      "dest": "/api/account?action=customer-orders"
    },
    {
      "src": "/api/auth-google-start/?",
      "dest": "/api/account?action=google-start"
    },
    {
      "src": "/api/auth-google-callback/?",
      "dest": "/api/account?action=google-callback"
    },
    {
      "src": "/api/auth-microsoft-start/?",
      "dest": "/api/account?action=microsoft-start"
    },
    {
      "src": "/api/auth-microsoft-callback/?",
      "dest": "/api/account?action=microsoft-callback"
    },
    {
      "src": "/api/auth-logout/?",
      "dest": "/api/account?action=logout"
    },
    {
      "src": "/api/update-site-content/?",
      "dest": "/api/account?action=update-site-content"
    },
    {
      "src": "/api/update-catalog-file/?",
      "dest": "/api/account?action=update-catalog-file"
    },
    {
      "src": "/api/upload-media/?",
      "dest": "/api/account?action=upload-media"
    },
    {
      "src": "/api/dropify-products/?",
      "dest": "/api/account?action=dropify-products"
    },
    {
      "src": "/api/dropify-webhook/?",
      "dest": "/api/account?action=dropify-webhook"
    },
    {
      "src": "/admin(?:/index\\.html)?/?",
      "dest": "/api/account?action=admin"
    },
    {
      "src": "/api/(.*)\\.js",
      "status": 404,
      "dest": "/404.html"
    },
    {
      "src": "/lib/(.*)",
      "status": 404,
      "dest": "/404.html"
    },
    {
      "src": "/scripts/(.*)",
      "status": 404,
      "dest": "/404.html"
    },
    {
      "src": "/private/(.*)",
      "status": 404,
      "dest": "/404.html"
    },
    {
      "handle": "filesystem"
    }
  ]
}
